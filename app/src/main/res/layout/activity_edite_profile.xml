<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F0EEEE"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="23dp"
        android:paddingEnd="11dp"
        android:paddingBottom="24dp">

        <!-- Toolbar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="#000000"
                android:textSize="42sp"
                android:layout_gravity="start|center_vertical"
                android:clickable="true"
                android:focusable="true" />

        </FrameLayout>

        <!-- Profile photo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/profileImage"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:src="@drawable/profile"
                android:scaleType="centerCrop"
                android:contentDescription="Profile photo"
                app:shapeAppearanceOverlay="@style/CircleImage" />

            <TextView
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:text="Edite Profile"
                android:textColor="#242033"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Name -->
        <TextView
            style="@style/PLabel"
            android:text="Name:" />

        <EditText
            android:id="@+id/etName"
            style="@style/ProfileInput"
            android:hint="Name"
            android:text="Ye Haoran"
            android:inputType="textPersonName" />

        <!-- Username -->
        <TextView
            style="@style/PLabel"
            android:text="Username:" />

        <EditText
            android:id="@+id/etUsername"
            style="@style/ProfileInput"
            android:hint="Username"
            android:text="Allie"
            android:inputType="text"
            android:singleLine="true" />

        <!-- Birthday -->
        <TextView
            style="@style/PLabel"
            android:text="Birthday:" />

        <EditText
            android:id="@+id/etBirthday"
            style="@style/ProfileInput"
            android:hint="DD/MMM/YY"
            android:text="02/Feb/26"
            android:focusable="false"
            android:clickable="true" />

        <!-- Number -->
        <TextView
            style="@style/PLabel"
            android:text="Number:" />

        <EditText
            android:id="@+id/etNumber"
            style="@style/ProfileInput"
            android:hint="Phone number"
            android:text="+885 548821"
            android:inputType="phone" />

        <!-- Add account -->
        <Button
            android:id="@+id/btnAddAccount"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#170B95"
            android:text="Add Another Account"
            android:textAllCaps="false"
            android:textColor="#FEFEFF"
            android:textSize="14sp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- Logout -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="112dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="27dp"
            android:backgroundTint="#FB0127"
            android:text="Log out"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>
</ScrollView>
