<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LMS" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.LMS" parent="Base.Theme.LMS" />
    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>



    <style name="ProfileLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">16sp</item>
    </style>

<!--    Edite Profile-->


    <style name="ProfileInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">33dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:background">@drawable/rounded_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textColorHint">#777777</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
    </style>



    <style name="PLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">33dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:background">@drawable/rounded_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textColorHint">#777777</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
    </style>


<!--    register-->


    <style name="RegisterInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">37dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textColorHint">#604C4C</item>
        <item name="android:singleLine">true</item>
    </style>

<!--    borrow_history-->



        <style name="BottomNavItem">
            <item name="android:layout_width">0dp</item>
            <item name="android:layout_height">match_parent</item>
            <item name="android:layout_weight">1</item>
            <item name="android:orientation">vertical</item>
            <item name="android:gravity">center</item>
        </style>

        <style name="BottomNavIcon">
            <item name="android:layout_width">wrap_content</item>
            <item name="android:layout_height">27dp</item>
            <item name="android:textSize">25sp</item>
            <item name="android:gravity">center</item>
        </style>

        <style name="BottomNavText">
            <item name="android:layout_width">wrap_content</item>
            <item name="android:layout_height">wrap_content</item>
            <item name="android:textSize">12sp</item>
            <item name="android:textColor">#777064</item>
        </style>








</resources>